# 复制为 .env 后填写（本地可选；Render 在控制台配置环境变量）

# 服务端口（Render 会自动注入 PORT，一般不用改）
PORT=3000

# MongoDB 连接串
# 本地默认：mongodb://localhost:27017/surveySystem
# 云端：MongoDB Atlas 的 mongodb+srv://...
MONGODB_URI=mongodb://localhost:27017/surveySystem

# 站点公网地址（部署后填 Render 给你的网址，不要末尾斜杠）
# 例：https://your-app.onrender.com
BASE_URL=http://localhost:3000

# Session 密钥（生产环境请换成随机长字符串）
SESSION_SECRET=please-change-me-to-a-long-random-string

# 生产环境 cookie 走 HTTPS 时设为 true（Render 上建议 true）
# COOKIE_SECURE=true
